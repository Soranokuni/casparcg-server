<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <paths>
        <media-path>@TESTDIR@/media/</media-path>
        <log-path disable="false">@TESTDIR@/log/</log-path>
        <data-path>@TESTDIR@/data/</data-path>
        <template-path>@TESTDIR@/template/</template-path>
    </paths>
    <log-level>info</log-level>
    <video-modes>
        <video-mode>
            <id>t180p50</id>
            <width>320</width>
            <height>180</height>
            <time-scale>50000</time-scale>
            <duration>1000</duration>
            <cadence>960</cadence>
        </video-mode>
        <video-mode>
            <id>t180i50</id>
            <width>320</width>
            <height>180</height>
            <field-count>2</field-count>
            <time-scale>25000</time-scale>
            <duration>1000</duration>
            <cadence>1920</cadence>
        </video-mode>
    </video-modes>
    <channels>
        <channel>
            <video-mode>t180p50</video-mode>
            <consumers />
        </channel>
        <channel>
            <video-mode>PAL</video-mode>
            <consumers />
        </channel>
        <channel>
            <video-mode>1080i5000</video-mode>
            <consumers />
        </channel>
    </channels>
    <controllers>
        <tcp>
            <port>5260</port>
            <protocol>AMCP</protocol>
        </tcp>
    </controllers>
    <osc>
        <default-port>6261</default-port>
        <disable-send-to-amcp-clients>true</disable-send-to-amcp-clients>
        <predefined-clients>
            <predefined-client>
                <address>127.0.0.1</address>
                <port>6260</port>
            </predefined-client>
        </predefined-clients>
    </osc>
</configuration>
